# Copy to supabase/functions/.env for `supabase functions serve`
# Local model on your PC (functions run in Docker, so use host.docker.internal)
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_MODEL=qwen2.5-14b-instruct
AI_JSON_MODE=none
AI_API_KEY=

# Later, hosted (examples – pick one):
# Gemini:    AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
# Anthropic: AI_BASE_URL=https://api.anthropic.com/v1                              AI_MODEL=claude-sonnet-5-5
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1                                 AI_MODEL=gpt-4.1-mini
