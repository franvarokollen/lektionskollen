# ── AI mode ────────────────────────────────────────────────
# "direct" = browser calls a local model (LM Studio / Ollama) — fastest for dev
# "edge"   = browser calls the Supabase Edge Function `generate-lesson` (prod path)
VITE_AI_MODE=direct

# Direct mode (local model, OpenAI-compatible endpoint)
#   LM Studio: http://localhost:1234/v1   (enable CORS in LM Studio server settings)
#   Ollama:    http://localhost:11434/v1  (start with OLLAMA_ORIGINS=http://localhost:5173)
VITE_AI_BASE_URL=http://localhost:1234/v1
VITE_AI_MODEL=qwen2.5-14b-instruct
# "json_object" if your server supports it (Ollama does), otherwise "none"
VITE_AI_JSON_MODE=none

# Edge mode (Supabase)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
